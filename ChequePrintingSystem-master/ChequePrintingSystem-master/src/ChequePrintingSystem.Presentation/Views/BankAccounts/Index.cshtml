@using ChequePrintingSystem.Domain.Entities
@using ChequePrintingSystem.Presentation.Models
@model PagedListViewModel<BankAccount>
@{
    var bankLookup = ViewBag.BankLookup as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">Bank Accounts</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>Create Account
    </a>
</div>

<div class="mb-3">
    <form method="get" class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label class="form-label form-label-sm mb-1">Search</label>
            <input name="q" class="form-control form-control-sm" value="@Model.Query" placeholder="Account number..." />
        </div>
        <div>
            <label class="form-label form-label-sm mb-1">Page size</label>
            <select name="pageSize" class="form-select form-select-sm">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </div>
        <input type="hidden" name="page" value="1" />
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-search me-1"></i>Search
        </button>
    </form>
</div>

<div class="mb-2">
    @if (Model.TotalCount == 0)
    {
        <span class="text-muted">No results found.</span>
    }
    else
    {
        <span class="text-muted">Showing page <b>@Model.Page</b> of <b>@Model.TotalPages</b> (@Model.TotalCount total)</span>
    }
</div>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Bank</th><th>Account</th><th>Opening Balance</th><th>Date(X,Y)</th><th>Payee(X,Y)</th><th>Amt Num(X,Y)</th><th>Amt Words(X,Y)</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model.Rows)
    {
        <tr>
            <td>@(bankLookup.TryGetValue(a.BankId, out var name) ? name : "N/A")</td>
            <td>@a.AccountNumber</td>
            <td>@a.OpeningBalance.ToString("N2")</td>
            <td>@a.DateX, @a.DateY</td>
            <td>@a.PayeeX, @a.PayeeY</td>
            <td>@a.AmountNumericX, @a.AmountNumericY</td>
            <td>@a.AmountWordsX, @a.AmountWordsY</td>
            <td>
                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@a.Id" />
                    <button class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Bank accounts pagination">
        <ul class="pagination pagination-sm justify-content-end">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-q="@Model.Query"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">
                    Page <b>@Model.Page</b> / @Model.TotalPages
                </span>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-q="@Model.Query"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
