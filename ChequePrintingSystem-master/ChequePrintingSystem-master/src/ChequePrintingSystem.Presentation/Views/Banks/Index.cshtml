@using ChequePrintingSystem.Domain.Entities
@using ChequePrintingSystem.Presentation.Models
@model PagedListViewModel<Bank>
<h4>Banks</h4>
<div class="mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
    <form method="get" class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label class="form-label form-label-sm mb-1">Search</label>
            <input name="q" class="form-control form-control-sm" value="@Model.Query" placeholder="Name or Swift..." />
        </div>
        <div>
            <label class="form-label form-label-sm mb-1">Page size</label>
            <select name="pageSize" class="form-select form-select-sm">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </div>
        <input type="hidden" name="page" value="1" />
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-search me-1"></i>Search
        </button>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>Create Bank
    </a>
</div>

<div class="mb-2">
    @if (Model.TotalCount == 0)
    {
        <span class="text-muted">No results found.</span>
    }
    else
    {
        <span class="text-muted">Showing page <b>@Model.Page</b> of <b>@Model.TotalPages</b> (@Model.TotalCount total)</span>
    }
</div>

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Swift</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var b in Model.Rows)
    {
        <tr>
            <td>@b.Name</td>
            <td>@b.SwiftCode</td>
            <td>
                <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@b.Id" />
                    <button class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Bank pagination">
        <ul class="pagination pagination-sm justify-content-end">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-q="@Model.Query"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">
                    Page <b>@Model.Page</b> / @Model.TotalPages
                </span>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-q="@Model.Query"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
